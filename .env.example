PORT=3000
JWT_SECRET=seu_jwt_secret_aqui
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# --- Pipeline de audio longo (opcional; defaults entre parenteses) ---
# Blocos transcritos em paralelo por job (3). Cada bloco e uma chamada a OpenRouter.
# CHUNK_CONCURRENCY=3
# Tamanho alvo de cada bloco em segundos (600). Cortes acontecem no silencio mais proximo.
# CHUNK_TARGET_SEC=600
# Tentativas por bloco em erro transitorio: 429, 5xx, rede (3).
# CHUNK_MAX_ATTEMPTS=3
# Timeout de uma chamada de transcricao em ms (600000 = 10 min).
# TRANSCRIBE_TIMEOUT_MS=600000

# --- Limites de upload (opcional) ---
# MAX_UPLOAD_GB=5
# MAX_FILES_PER_UPLOAD=50
# MAX_AUDIO_HOURS=10

# --- Somente para testes de mecanica (NUNCA em producao; o servidor recusa) ---
# TRANSCRIBE_PROVIDER=mock
