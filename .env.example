PORT=3000
# JWT_SECRET obrigatorio em producao (NODE_ENV=production). O servidor recusa subir com valor padrao.
JWT_SECRET=seu_jwt_secret_aqui
# APP_SECRET_KEY: chave-mestra da cifra em repouso (AES-256-GCM) dos segredos no SQLite
# (hoje: a chave da OpenRouter). Obrigatoria em producao — o servidor recusa subir sem ela.
# Minimo 32 chars, aleatoria. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# GUARDE ESTE VALOR: sem ele, a chave OpenRouter cifrada no banco NAO pode ser lida de novo.
APP_SECRET_KEY=seu_app_secret_key_aleatorio_aqui

# --- Admin inicial (T-32) ---
# Usado UMA vez no seed do primeiro admin (banco novo). Depois troque pelo painel.
# Em producao (NODE_ENV=production): ADMIN_PASSWORD e OBRIGATORIO (min. 8 chars) —
# o servidor recusa subir sem ele. Fora de producao o default e 'admin123' e um
# usuario demo (pedro.leon23@gmail.com / user123) e criado junto; em producao
# o usuario demo NUNCA e criado.
#ADMIN_EMAIL=admin@seudominio.com
#ADMIN_PASSWORD=troque_antes_do_primeiro_boot
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# --- Pipeline de audio longo (opcional; defaults entre parenteses) ---
# Blocos transcritos em paralelo por job (3). Cada bloco e uma chamada a OpenRouter.
# CHUNK_CONCURRENCY=3
# Tamanho alvo de cada bloco em segundos (600). Cortes acontecem no silencio mais proximo.
# CHUNK_TARGET_SEC=600
# Tentativas por bloco em erro transitorio: 429, 5xx, rede (3).
# CHUNK_MAX_ATTEMPTS=3
# Timeout de uma chamada de transcricao em ms (600000 = 10 min).
# TRANSCRIBE_TIMEOUT_MS=600000

# --- Limites de upload (opcional) ---
# MAX_UPLOAD_GB=5
# MAX_FILES_PER_UPLOAD=50
# MAX_AUDIO_HOURS=10

# --- Somente para testes de mecanica (NUNCA em producao; o servidor recusa) ---
# TRANSCRIBE_PROVIDER=mock

# T-06: arquivos processados simultaneamente (default 2; inteiro 1..32).
WORKER_CONCURRENCY=2
# Limite total por tentativa do arquivo; cancela antes de reenfileirar.
WORKER_TIMEOUT_MINUTES=30
# Maximo de tentativas automaticas por arquivo (1..10).
WORKER_MAX_ATTEMPTS=3

# --- Protecao da troca de chave OpenRouter (T-15) ---
# Salvar/trocar chave exige a senha do admin autenticado. Apos N senhas
# erradas dentro da janela, o IP fica bloqueado (429) ate a janela expirar.
# Defaults: 5 falhas / 10 minutos. Estado em memoria — restart zera o contador.
#KEY_AUTH_MAX_FAILURES=5
#KEY_AUTH_WINDOW_MINUTES=10

# --- Banco de dados (T-08) ---
# T-08: banco de dados. O app roda em SQLite (DB_DRIVER=sqlite, default) ou
# PostgreSQL (DB_DRIVER=postgres) — o mesmo schema nos dois drivers.
# Cutover (feito em 29/09/2026 no ambiente local): rode o ETL
# (node scripts/migrate-sqlite-to-postgres.js com o app parado) e depois
# descomente DB_DRIVER=postgres. Rollback = comentar de volta ANTES de
# novas escritas no Postgres (o que entrar no PG depois do ETL nao volta
# sozinho pro SQLite).
# POSTGRES_USER=transcreveai
# POSTGRES_PASSWORD=troque_esta_senha_em_producao
# POSTGRES_DB=transcreveai
# Conexao usada pelo app (driver postgres) e pelo script de migracao
# (sobrescreve as vars acima se definida):
# DATABASE_URL=postgres://transcreveai:senha@db:5432/transcreveai
# DB_DRIVER=postgres

# --- E-mail transacional / auto-cadastro (T-28) ---
# Sem SMTP configurado: em producao (NODE_ENV=production) o cadastro publico
# fica DESABILITADO (503 com aviso); em desenvolvimento o link de confirmacao
# vai para o log do servidor (fluxo testavel de graca).
# Excecao para self-host local: REGISTRATION_REQUIRES_SMTP=false abre o
# cadastro mesmo sem SMTP — o link de confirmacao vai para o LOG do servidor.
# REGISTRATION_REQUIRES_SMTP=false
# Preencha para liberar: cadastro -> e-mail de confirmacao -> conta ativa.
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=usuario@smtp
# SMTP_PASS=senha_smtp
# SMTP_SECURE=true somente para porta 465 (default false)
# MAIL_FROM="Falou.ai <no-reply@seudominio.com>"
# URL publica usada nos links dos e-mails (default http://localhost:3000)
# PUBLIC_BASE_URL=https://transcreve.seudominio.com

# --- Cobrança recorrente via Asaas (T-27) ---
# Sem ASAAS_API_KEY a plataforma roda normal, mas os botões de assinatura
# ficam "Em breve". Com a key, o usuário assina Bronze/Prata/Ouro e paga via
# PIX/boleto/cartão na fatura Asaas; o plano é liberado automaticamente pelo
# webhook (pagamento confirmado) e suspenso em atraso.
# Sandbox (testes): https://sandbox.asaas.com/api/v3
# Produção:        https://www.asaas.com/api/v3
# ASAAS_API_KEY=$aact_... (Integrações -> API no painel Asaas)
# ASAAS_API_URL=https://sandbox.asaas.com/api/v3
# Token que o Asaas envia no header `asaas-access-token` de cada webhook.
# Gere um valor aleatório e configure o MESMO valor no painel Asaas
# (Webhooks -> URL + token). URL do webhook: https://seu-dominio/api/webhooks/asaas
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# ASAAS_WEBHOOK_TOKEN=token_aleatorio_gerado
# Em produção (NODE_ENV=production) o servidor RECUSA SUBIR sem
# ASAAS_WEBHOOK_TOKEN. Para desenvolver localmente sem cobrança, use:
# BILLING_STRICT=false
# Preços e cotas (R$ / transcrições por dia) vivem em system_settings —
# o admin ajusta no painel (Configurações); defaults: bronze 19.90/15,
# prata 49.90/60, ouro 99.90/ilimitado.
